# QuickChat Environment Variables
# Copy this file to .env and fill in values after deploying AWS backend

# Amazon Cognito
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# API Gateway WebSocket URL (from SAM deploy output)
VITE_WEBSOCKET_URL=wss://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/prod

# API Gateway REST URL (from SAM deploy output)
VITE_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/prod

# S3 Bucket for attachments (from SAM deploy output)
VITE_ATTACHMENTS_BUCKET=quickchat-attachments-xxxxxxxxxxxx

# Note: Leave these empty or remove the .env file to run in Demo Mode
# Demo Mode uses mock data and doesn't require any AWS services
